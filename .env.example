# Public browser configuration (never put secrets in VITE_* variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional server alias. When omitted, server functions use the VITE_ public key above.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your-restricted-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_replace_me

# Server-only secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
APP_URL=https://app.example.com
VITE_SITE_URL=https://app.example.com
CRON_SECRET=replace-with-at-least-32-random-characters
REFERENCING_WEBHOOK_SECRET=replace-with-provider-webhook-secret
PUBLIC_RELEASE_SHA=replace-with-deployment-git-sha
# Server-side Google Maps connector key used through the Lovable gateway.
GOOGLE_MAPS_API_KEY=replace-with-server-maps-connection-key

# Transactional email (server only). Use a sending-only API key and a verified domain.
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
EMAIL_FROM=Estately <notifications@example.com>
EMAIL_REPLY_TO=support@example.com

# Optional AVM adapter. It must accept the request documented in
# src/lib/valuation.functions.ts and return its validated response shape.
VALUATION_PROVIDER_URL=https://your-avm-adapter.example/valuation
VALUATION_PROVIDER_API_KEY=replace-with-provider-api-key

# Development/demo only. Leave false in production.
ENABLE_DEMO_BANK_FEED=false
# Simulated tenant referencing results. Leave false until a real provider is wired.
ENABLE_SIMULATED_REFERENCING=false

# Comma-separated exact hosts or wildcard subdomains (for example:
# hooks.example.com,*.trusted-automation.example)
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=

# Stripe/Lovable connection. Keep sandbox configured until the end-to-end
# checkout and webhook flow has passed in the Stripe test environment.
BILLING_STRIPE_ENV=sandbox
PAYMENTS_STRIPE_ENV=sandbox
STRIPE_SANDBOX_API_KEY=replace-with-lovable-sandbox-connection-key
STRIPE_LIVE_API_KEY=replace-with-lovable-live-connection-key
LOVABLE_API_KEY=replace-with-lovable-api-key
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_replace_me
PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_replace_me
# Subscribe each environment's endpoint to checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, and customer.subscription.created/updated/deleted.
BILLING_STARTER_PRICE_ID_SANDBOX=price_replace_me
BILLING_GROWTH_PRICE_ID_SANDBOX=price_replace_me
BILLING_UNLIMITED_PRICE_ID_SANDBOX=price_replace_me
BILLING_STARTER_PRICE_ID_LIVE=price_replace_me
BILLING_GROWTH_PRICE_ID_LIVE=price_replace_me
BILLING_UNLIMITED_PRICE_ID_LIVE=price_replace_me
