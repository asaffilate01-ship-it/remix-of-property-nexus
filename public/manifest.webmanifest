  "categories": ["business", "productivity", "utilities"],
  "icons": [
    { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "short_name": "Dashboard", "url": "/dashboard", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Properties", "short_name": "Properties", "url": "/properties", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "Leads", "short_name": "Leads", "url": "/leads", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
    { "name": "On-site inspection", "short_name": "Inspect", "url": "/mobile-inspection", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] }
  ],
  "prefer_related_applications": false
