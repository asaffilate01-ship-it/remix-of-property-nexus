{
  "name": "Gabley — Where property comes together",
  "short_name": "Gabley",
  "description": "Sales, lettings, HMO and commercial in one premium workspace for UK agencies and landlords.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
